# Local-only topics — not published to Cloudflare
ai4s/
scisci/
ai4s+scisci/
smart-laboratory/

# Local dev caches — never deployed
_local_keys.json
_zotero_keys.json
_zotero_meta.json

# Local review locks, provider caches, staging, partials and rollback copies
papers/.*.local-review*
papers/._papers_index.json.flock
papers/.corpus-operation.flock
papers/*/.corpus-reservation.json
papers/.extract-stage-*/
papers/*/_pc_*.json
papers/*/audio_script.txt
papers/*/audio_script.meta.json
papers/**/.local-review*
papers/**/.cache/
papers/**/.tmp/
papers/**/metadata.json
papers/**/metadata.local.json
# Bibliography sidecars contain local PDF paths and original Zotero metadata
papers/*/bibliography.json

# Obsidian / Claude Code / OMC runtime files
.obsidian/
**/.obsidian/
.claude/
**/.claude/
.omc/
**/.omc/

# Personal notes (local-only)
notes/
papers/*/notes.md

# Multi-paper comparisons (paper-curio local feature)
papers/_comparisons/

# .html 다운로드용 figure data URI (file:// 전용 크러치 — 전량 약 1GB).
# https 에서는 버튼이 fetch 로 원본 바이트를 그대로 가져오므로 불필요하다.
papers/*/_figs_inline.js

# Source markdown (only HTML is served)
papers/*/review.md
papers/*/text.md
papers/*/originality.md
# 지표 데이터 (로컬 전용) — 200편 실측 32.9MB, 전량 환산 약 244MB.
# 인용목록이 논문당 수만 행까지 가므로 배포에 올리면 안 된다.
papers/*/citations.md
papers/*/references.md
papers/*/citedby/


# Cross-topic 통합 Deep Research (로컬 전용)
_cross/

# Cloudflare Workers 25 MiB asset 한도 초과 — GitHub 로만 제공
public/260715_AIX_clinic_paper_curation.pdf

# Agent/WIP · 런타임 · 잡파일 (비공개; 일부 25MiB 초과)
_agent/
.gjc/
.DS_Store
.assetsignore.pre-physicalai
