#!/bin/sh
# pre-push hook for paper-curation
# Install: bash scripts/install-hooks.sh   (idempotent, self-verifying)
#
# Design — two tiers so the security guard is always on without slowing pushes:
#   1. Secret-leak scan  → HARD BLOCK (exit 1). Fast (~5s). Anthropic/OpenAI keys.
#   2. validate_papers   → ADVISORY (warns, never blocks). It is a *deploy* gate,
#      not a push gate; the hard gate lives in CI (schema-drift / secret-scan)
#      and in prepare_deploy. Blocking every push on unrelated data issues would
#      only train `git push --no-verify`, which also disables the secret scan.
#
# Skip everything with: git push --no-verify

set -e

# ── 1. Secret leak detection (HARD BLOCK) ───────────────────────────────────
echo "[pre-push] scanning for API key leaks…"
RANGE="@{u}..HEAD"
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    RANGE="HEAD"
fi
LEAK=$(git diff "$RANGE" | grep -E 'sk-(ant|proj)-[A-Za-z0-9_-]{10,}' || true)
if [ -n "$LEAK" ]; then
    echo "[pre-push] ❌ API key leak detected — refusing push"
    echo "$LEAK" | head -5
    exit 1
fi
echo "[pre-push] ✓ no leaks"

# ── 2. validate_papers (ADVISORY — never blocks the push) ───────────────────
TOPIC="${PAPER_CURATION_TOPIC:-ai4s}"
if [ -f pipeline/validate_papers.py ]; then
    echo "[pre-push] validate_papers --topic $TOPIC --strict (advisory)"
    if ! PYTHONUTF8=1 python pipeline/validate_papers.py --topic "$TOPIC" --strict >/tmp/_pp_validate.log 2>&1; then
        echo "[pre-push] ⚠ validate_papers reported issues (not blocking push):"
        tail -12 /tmp/_pp_validate.log
        echo "[pre-push] ⚠ fix before deploy — CI and prepare_deploy enforce this hard."
    else
        echo "[pre-push] ✓ validate_papers passed"
    fi
fi

exit 0
